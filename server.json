{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lazytitan30/billing-doctor",
  "description": "Diagnose Google Play Billing incidents locally, with evidence. Not affiliated with Google.",
  "repository": {
    "url": "https://github.com/lazytitan30/billing-doctor",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "billing-doctor",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
